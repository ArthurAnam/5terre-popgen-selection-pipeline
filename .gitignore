# ============================================================
# Python / cache / temporary files
# ============================================================

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.envrc

# IDE / editor files
.vscode/
.idea/
.DS_Store
tempCodeRunnerFile.py


# ============================================================
# Snakemake / workflow execution
# ============================================================

.snakemake/
snakemake_tmp/
*.snakemake.log


# ============================================================
# Generated pipeline outputs
# ============================================================

results/**
!results/
!results/**/
!results/**/.gitkeep

logs/**
!logs/
!logs/**/
!logs/**/.gitkeep

benchmarks/**
!benchmarks/
!benchmarks/**/
!benchmarks/**/.gitkeep


# ============================================================
# Input and processed genomic data
# ============================================================

data/**
!data/
!data/**/
!data/**/.gitkeep


# ============================================================
# Large genomic file formats
# ============================================================

# Variant files
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.vcf.gz.csi
*.bcf
*.bcf.csi

# Alignment files
*.sam
*.bam
*.bam.bai
*.cram
*.cram.crai

# FASTQ files
*.fq
*.fq.gz
*.fastq
*.fastq.gz

# PLINK / genotype formats
*.bed
*.bim
*.fam
*.ped
*.map
*.pgen
*.pvar
*.psam
*.gen
*.sample
*.bgen
*.bgi

# Phasing / haplotype files
*.haps
*.hap
*.hap.gz
*.legend
*.phased
*.shapeit*

# Reference genome files
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.fai
*.dict


# ============================================================
# Compressed archives and large intermediate files
# ============================================================

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

*.tmp
*.temp
*.bak
*.backup


# ============================================================
# Keep placeholder files
# ============================================================

!.gitkeep
